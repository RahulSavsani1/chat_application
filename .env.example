# MongoDB connection string for the chat_application database.
MONGO_URL=mongodb://127.0.0.1:27017/chat_application

# Public application and Socket.IO addresses.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:8080
# Server-side address used by the Next.js API to publish events to Socket.IO.
SOCKET_SERVER_URL=http://127.0.0.1:8080
# WS_PORT is the local Socket.IO port; Render supplies PORT automatically.
WS_PORT=8080
SOCKET_ALLOWED_ORIGINS=http://localhost:3000

# Set a long random secret for production. In development, the app falls back
# to MONGO_URL when SOCKET_INTERNAL_SECRET is empty.
SOCKET_INTERNAL_SECRET=

# Optional Google OAuth. Set the redirect URI to the exact callback URL
# registered with Google, for example http://localhost:3000/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Transactional SMTP credentials. Use your email provider's service credentials
# and a verified sender on your app domain, not a personal mailbox password.
# When SMTP is blank, development shows a temporary OTP; production requires the explicit fallback flag below.
# For port 587 use SMTP_SECURE=false; for port 465 use SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional temporary recovery for a public deployment without SMTP.
# Set true only while testing: the OTP is returned to the requester instead of emailed.
PASSWORD_RESET_ALLOW_OTP_FALLBACK=false

# NODE_ENV=development # Set automatically by Next.js; do not uncomment.
